#!/usr/bin/env bash

start_tmux() {
    rm /tmp/start-tmux
    if [[ $LC_TERMINAL = "iTerm2" ]]
    then
        tmux -CC attach || tmux -CC
    else
        zellij attach || zellij
    fi
}

# ======================================================================
# main
# ======================================================================
host=$(hostname)
if [[ $host = "debian1" ]]
then
    start_tmux
elif [[ $host = "macbookair.local" ]]
then
    ssh debian1 "touch /tmp/start-tmux"
    ssh debian1
fi
