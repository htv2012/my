#!/usr/bin/env bash
# Run a single-file go module
set -e

src="${1:?Please supply a Go file.}"
exe="/tmp/bin/${1%.go}"


go fmt "$src"
go vet "$src"

if which staticcheck > /dev/null 2> /dev/null
then
    staticcheck "$src"
fi

go build -o "$exe" "$src"

echo "Source:"
bat -n --tabs=8 --paging never "$src"

echo ""
echo "Output:"
"$exe"
