#!/usr/bin/env python3
"""Display list of kids and their favorite food."""
import argparse
import csv
import pathlib
import itertools
import collections


def main():
    # Read data
    data = collections.defaultdict(lambda: collections.defaultdict(list))
    data_path = pathlib.Path(__file__).parent.parent / "etc" / "food.csv"
    with open(data_path, "r", encoding="utf-8") as stream:
        reader = csv.reader(stream)
        for place, person, food in reader:
            data[place][person].append(food)

    # Display
    for place, person_food in sorted(data.items()):
        print(f"\n# {place}")
        for person, food_list in sorted(person_food.items()):
            print(f"  - {person}: ", end="")
            print(", ".join(sorted(food_list)))


if __name__ == '__main__':
    main()


