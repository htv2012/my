#
# Common
#
export PS1="\n\h:\w\n\\$\[$(tput sgr0)\] "

#
# ls and friends
#

case $(uname) in
    Darwin|*BSD)
        alias ls='ls -G'
        export LSCOLORS='GxFxcxdxCxegedabagacad'
        ;;
    Linux|CYGWIN*)
        alias ls='ls --color=auto'
        export LS_COLORS='di=1;36:ln=1;35:so=32:pi=33:ex=1;32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43'
        ;;
esac

alias la='ls -A'
alias ll='ls -hl'
alias lla='ls -hAl'
alias lld='ll -d'
alias ltr='ls -lGtr'

#
# cd and friends
#
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias cdbak='cd /mnt/pool1/work/macbookair.local'

