// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ssh_connections": [
    {
      "host": "debian1",
      "args": [],
      "projects": [
        {
          "paths": ["/home/haiv"],
        },
        {
          "paths": ["/home/haiv/Projects"],
        },
        {
          "paths": ["/home/haiv/Projects/pytest-sandbox/./"],
        },
        {
          "paths": ["/home/haiv/Projects/python-sandbox/./"],
        },
        {
          "paths": [
            "/home/haiv/Projects/python-sandbox/3party/click/json-type/./",
          ],
        },
        {
          "paths": ["/home/haiv/my"],
        },
      ],
    },
  ],
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright"],
    },
    "Go": {
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "tab_size": 8, // Standard Go visual width is 8, but 4 is common
      "hard_tabs": true, // This is the critical setting for Go
      "format_on_save": "on",
      "formatter": "language_server",
    },
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
        "ui.completion.usePlaceholders": true,
        "ui.diagnostic.staticcheck": true,
      },
    },
  },
}
